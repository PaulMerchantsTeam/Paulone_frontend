<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- English Banner -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/banner_blue_background"
            android:padding="@dimen/_14sdp"
            android:text="@string/lnt_text_eng"
            android:textColor="@color/white"
            android:textSize="@dimen/_10ssp"
            android:lineSpacingExtra="7.49sp"
            android:letterSpacing="-0.01"
            android:gravity="center"
            android:textStyle="normal"/>

        <!-- Section Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="To make your interest payments,"
            android:textSize="@dimen/_14ssp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="@color/black_lnt"
            android:layout_marginTop="16dp" />

        <!-- Click Here Button -->
        <Button
            android:id="@+id/clickButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Click Here"
            android:backgroundTint="@color/button_lnt"
            android:textColor="@color/black_lnt"
            android:textStyle="bold"
            android:textSize="@dimen/_11ssp"
            android:layout_marginTop="8dp" />

        <!-- OR Divider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginVertical="12dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/divide_lnt" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OR"
                android:textSize="@dimen/_8ssp"
                android:textColor="@color/or_lnt"
                android:paddingHorizontal="8dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/divide_lnt" />
        </LinearLayout>

        <!-- Web Instructions -->
        <TextView
            android:id="@+id/visitSite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/visit_site"
            android:textStyle="bold"
            android:textSize="@dimen/_14ssp"
            android:lineSpacingExtra="7.49sp"
            android:letterSpacing="-0.01"
            android:textAlignment="center"
            android:textColor="@color/black_lnt"
            />

        <!-- App Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingHorizontal="@dimen/_20sdp"
            android:layout_gravity="center"
            android:background="@drawable/banner_yellow_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/_30sdp"
                android:gravity="center">

                <ImageView
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:src="@drawable/planet_app_logo"
                    android:contentDescription="Planet App Logo" />

                <TextView
                    android:id="@+id/dwnld_app_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dwld_planet_app"
                    android:textAlignment="center"
                    android:textColor="@color/black_lnt"
                    android:layout_marginStart="12dp"
                    android:textSize="@dimen/_11ssp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divide_lnt"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/web_lnt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/visit_lnt"
                android:textColor="@color/black_lnt"
                android:textAlignment="center"
                android:layout_marginTop="12dp"
                android:textSize="@dimen/_11ssp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divide_lnt"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="You may also connect with your branch for additional information."
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textSize="@dimen/_11ssp"
                android:textColor="@color/black_lnt" />
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@drawable/doted_line"
            android:layout_marginVertical="18dp" />


        <!-- Hindi Banner -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/banner_blue_background"
            android:padding="@dimen/_14sdp"
            android:text="@string/lnt_text_hi"
            android:textColor="@color/white"
            android:textSize="@dimen/_10ssp"
            android:lineSpacingExtra="7.49sp"
            android:letterSpacing="-0.01"
            android:gravity="center"
            android:textStyle="normal"/>


        <!-- Hindi Payment Prompt -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="अपने ब्याज भुगतान करने के लिए,"
            android:textSize="@dimen/_14ssp"
            android:textStyle="bold"
            android:textColor="@color/black_lnt"
            android:gravity="center"
            android:layout_marginTop="16dp" />

        <!-- Hindi Button -->
        <Button
            android:id="@+id/clickButtonHin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="यहाँ क्लिक करें"
            android:backgroundTint="@color/button_lnt"
            android:textColor="@color/black_lnt"
            android:textStyle="bold"
            android:textSize="@dimen/_11ssp"
            android:layout_marginTop="8dp" />

        <!-- OR Divider Hindi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginVertical="12dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/divide_lnt" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="या"
                android:textSize="@dimen/_8ssp"
                android:textColor="@color/or_lnt"
                android:paddingHorizontal="8dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/divide_lnt" />
        </LinearLayout>

        <!-- Hindi Web Instructions -->
        <TextView
            android:id="@+id/visitSiteHin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/visit_site_hin"
            android:textStyle="bold"
            android:textSize="@dimen/_14ssp"
            android:lineSpacingExtra="7.49sp"
            android:letterSpacing="-0.01"
            android:textAlignment="center"
            android:textColor="@color/black_lnt" />

        <!-- Hindi App Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/banner_yellow_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/_30sdp"
                android:gravity="center">

                <ImageView
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:src="@drawable/planet_app_logo"
                    android:contentDescription="Planet App Logo" />

                <TextView
                    android:id="@+id/dwnld_app_text_hin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dwld_planet_app_hin"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/black_lnt"
                    android:textSize="@dimen/_11ssp" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divide_lnt"
                android:layout_marginTop="12dp" />
            <TextView
                android:id="@+id/webLntHin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/visit_lnt_hin"
                android:layout_marginTop="12dp"
                android:textAlignment="center"
                android:textColor="@color/black_lnt"
                android:textSize="@dimen/_11ssp" />
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divide_lnt"
                android:layout_marginTop="12dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="आप अपनी शाखा से अतिरिक्त जानकारी के लिए भी संपर्क कर सकते हैं"
                android:layout_marginTop="8dp"
                android:textAlignment="center"
                android:textColor="@color/black_lnt"
                android:textSize="@dimen/_11ssp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
